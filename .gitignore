# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Operating-system and editor files
.DS_Store
.idea/
.vscode/

# Web build and dependencies
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/.vite/

# Large, reproducibly downloaded AHBA files
data/ahba/*
!data/ahba/.gitkeep

# Reproducible donor-level matrices (about 151 MB total)
data/intermediate/donor_*_expression.csv

# Retain only the atlas files required by the pipeline and its documentation
data/atlases/aal_3v2/*
!data/atlases/aal_3v2/AAL3/
data/atlases/aal_3v2/AAL3/*
!data/atlases/aal_3v2/AAL3/AAL3v1.nii.gz
!data/atlases/aal_3v2/AAL3/AAL3v1.xml
!data/atlases/aal_3v2/AAL3/AAL3_UserGuide_April2024.pdf

# Keep publication/QC figures, but ignore any other ad-hoc PNG outputs
results/figures/*.png
!results/figures/.gitkeep
!results/figures/ahba_*.png
!results/figures/stage_02_*.png
!results/figures/stage_03_*.png
!results/figures/stage_04_*.png
!results/figures/stage_05_*.png
!results/figures/stage_06_*.png
!results/figures/stage_07_*.png
!results/figures/stage_08_*.png
!results/figures/web_atlas_region_validation.png
